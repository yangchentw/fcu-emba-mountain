---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { externalLinks, pages, site } from '../data/site';
interface Props { title: string; description: string; path: string }
const { title, description, path } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteBase = new URL(base, site.url).href;
const canonical = new URL(path.replace(/^\//, ''), siteBase).href;
const image = (name: string) => `${base}images/${name}`;
const pageImages: Record<string, { src: string; alt: string; className?: string }> = {
  '/about/': { src: image('about-mountain.jpg'), alt: '高山步道與遠方山景' },
  '/legacy/': { src: image('legacy-trail.jpg'), alt: '登山者與合歡北峰 3422M 山頂牌子', className: 'page-image--legacy' },
  '/activities/': { src: image('activity-landscape.jpg'), alt: '雲海與山巒景觀' },
  '/join/': { src: image('join-ridge.jpg'), alt: '山稜與天空景觀' },
};
const pageImage = pageImages[path];
const socialImage = pageImage ?? { src: image('hero-mountain.jpg'), alt: '逢甲大學 EMBA 峰鷹登山協會山景' };
const absoluteImage = new URL(socialImage.src.replace(base, ''), siteBase).href;
const organizationId = new URL('#organization', siteBase).href;
const websiteId = new URL('#website', siteBase).href;
const pageLabel = path === '/' ? '首頁' : pages.find((page) => page.href === path)?.label ?? title;
const breadcrumbs = [
  { name: '首頁', item: siteBase },
  ...(path === '/' ? [] : [{ name: pageLabel, item: canonical }]),
];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: site.name,
      url: siteBase,
      logo: new URL(site.logo, siteBase).href,
      sameAs: [externalLinks.facebook],
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: site.name,
      url: siteBase,
      inLanguage: 'zh-Hant',
      publisher: { '@id': organizationId },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      name: title,
      description,
      url: canonical,
      inLanguage: 'zh-Hant',
      isPartOf: { '@id': websiteId },
      primaryImageOfPage: { '@type': 'ImageObject', url: absoluteImage },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((breadcrumb, position) => ({
        '@type': 'ListItem',
        position: position + 1,
        name: breadcrumb.name,
        item: breadcrumb.item,
      })),
    },
  ],
};
---
<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{`${title} ｜ ${site.name}`}</title><meta name="description" content={description} /><meta name="robots" content="index,follow" /><link rel="canonical" href={canonical} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} /><meta property="og:site_name" content={site.name} /><meta property="og:locale" content="zh_TW" /><meta property="og:image" content={absoluteImage} /><meta property="og:image:alt" content={socialImage.alt} /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={absoluteImage} /><script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script></head><body><a class="skip" href="#main">跳至主要內容</a><Header />{pageImage && <img class:list={['page-image', pageImage.className]} src={pageImage.src} alt={pageImage.alt} loading="eager" />}<main id="main"><slot /></main><Footer /></body></html>
