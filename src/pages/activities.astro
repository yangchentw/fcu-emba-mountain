---
import BaseLayout from '../layouts/BaseLayout.astro'; import CtaLink from '../components/CtaLink.astro'; import { externalLinks } from '../data/site';
---
<BaseLayout title="活動與社群" description="峰鷹登山協會的社團日、假日活動與 Facebook 社群。" path="/activities/"><section><p>ACTIVITIES</p><h1>活動與社群</h1><h2>在日常相聚，也在山裡前行。</h2><p>社團日原則上於每月第二、四週星期四晚上 7 時至 9 時舉辦；另有每月一次假日活動。實際地點、報名與行程依每次公告為準。</p><p>最新活動訊息、花絮與夥伴交流，請加入 Facebook 社群。</p><CtaLink href={externalLinks.facebook} label="前往 Facebook 社群" external /></section></BaseLayout>
