---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaLink from '../components/CtaLink.astro';
import { externalLinks } from '../data/site';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="登上山，走向更遠" description="逢甲 EMBA 峰鷹登山協會官方網站。" path="/">
  <section class="hero"><div><p>FCU EMBA MOUNTAIN</p><h1 class="hero-poem">山的美，雲知道<br />雲的媚，風明瞭<br />風的勁，山頂上的您知曉</h1><div class="hero-cta"><CtaLink href={externalLinks.recruitment} label="立即加入第三屆" external /></div></div></section>
  <section class="story story-photo story-forest reveal"><div><p>2014 → 2023</p><h2>因山相聚，因同行而更遠。</h2><p class="lead">我們推廣登山運動、正確的山野知識與安全意識，也珍惜自然保育與 EMBA 學長姐間的情誼。</p><a href={`${base}about/`}>認識峰鷹 →</a></div></section>
  <section class="story story-photo story-activity reveal"><div><h2>一起走進山裡</h2><p>每月社團日與假日活動，最新公告與活動花絮在 Facebook 社群。</p><a href={`${base}activities/`}>探索活動與社群 →</a></div></section>
  <section class="story reveal"><h2>傳承，向上</h2><p>一屆又一屆，讓峰鷹持續飛向更高、更遠的山。</p><a href={`${base}legacy/`}>查看組織與傳承 →</a></section>
  <section class="story" aria-labelledby="association-information">
    <p>ASSOCIATION INFORMATION</p>
    <h2 id="association-information">協會資訊</h2>
    <dl>
      <dt>逢甲大學 EMBA 峰鷹登山協會是什麼？</dt>
      <dd>由逢甲大學 EMBA 愛山夥伴組成，透過登山運動與山野交流，延續彼此的情誼與學習。</dd>
      <dt>協會推廣什麼？</dt>
      <dd>協會推廣登山技能與安全意識，同時重視自然保育、環境與生態，並促進 EMBA 學長姐間的連結。</dd>
      <dt>活動資訊在哪裡發布？</dt>
      <dd>社團日、假日活動與最新公告，均以 Facebook 社群的實際公告為準。</dd>
      <dt>如何加入協會？</dt>
      <dd>符合會員資格並認同協會宗旨者，可透過第三屆招生報名表提出申請；資格與會費以協會公告及章程為準。</dd>
    </dl>
  </section>
  <script is:inline src={`${base}reveal.js`}></script>
</BaseLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@500&display=swap');

  .hero-poem {
    color: #fff;
    font-family: 'Noto Serif TC', serif;
    font-size: clamp(2rem, 4.8vw, 4.35rem);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.55;
    margin: 0 auto;
    max-width: 16em;
  }

  .hero-cta {
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }

  @media (max-width: 760px) {
    .hero-poem {
      font-size: clamp(1.65rem, 7.4vw, 2.35rem);
      letter-spacing: 0.045em;
      line-height: 1.65;
    }
  }
</style>
